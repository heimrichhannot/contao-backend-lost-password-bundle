{% extends '@Contao/be_login' %}

{% block error_messages %}
    <div class="formbody lost-password-formbody">
        <h1>{{ headline }}</h1>
        <p>{{ errorMessage }}</p>
    </div>
{% endblock %}

{% block form %}
    <form class="tl_login_form" method="post">
        <div class="formbody">
            <input type="hidden" name="FORM_SUBMIT" value="tl_reset_password">
            <input type="hidden" name="REQUEST_TOKEN" value="{{ requestToken }}">
            <h1>{{ headline }}</h1>
            <p>{{ explain }}</p>
            {{ fields|raw }}
            <div class="submit_container cf">
                <button type="submit" name="login" id="login" class="tl_submit">{{ submitButton }}</button>
            </div>
        </div>
    </form>
{% endblock %}

{% block container %}
    <div id="container">
        <main id="main">
            {% if errorMessage|default %}
                {{ block(error_messages) }}
            {% else %}
                {{ block(form) }}
            {% endif %}
        </main>
    </div>
{% endblock %}
