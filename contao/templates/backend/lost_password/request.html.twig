{% extends '@Contao/backend/lost_password/_wrapper.html.twig' %}

{% block container %}
    <div id="container">
        <main id="main">
            {% block content %}
                <form class="tl_login_form" method="post">
                    <div class="formbody">
                        <input type="hidden" name="FORM_SUBMIT" value="tl_request_password">
                        <input type="hidden" name="REQUEST_TOKEN" value="{{ contao.request_token }}">
                        <h1>{{ headline }}</h1>
                        <p>{{ explain }}</p>
                        <div class="widget widget-text">
                            <label for="username">{{ username }}</label>
                            <input type="text" name="username" id="username" class="tl_text" autocapitalize="off"
                                   autocomplete="username" placeholder="{{ username }}" required>
                        </div>
                        <div class="submit_container">
                            <button type="submit" name="login" id="login" class="tl_submit">{{ submitButton }}</button>
                        </div>
                    </div>
                </form>
            {% endblock %}
        </main>
        {{ messages|raw }}
        {% include '@Contao/backend/lost_password/_links.html.twig' %}
    </div>
{% endblock %}





